<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Budget {{ b.window.end.strftime('%d.%m.%Y') }}</title>
<style>
  @font-face { font-family: "Planner"; font-weight: 500; font-display: block; src: url("{{ fonts[500] }}") format("woff2"); }
  @font-face { font-family: "Planner"; font-weight: 700; font-display: block; src: url("{{ fonts[700] }}") format("woff2"); }
  :root {
    --paper: #ffffff; --ink: #1b1b19; --muted: #67675f; --rule: #cfcfc7; --hair: #e9e9e3; --column: #f6f6f2;
    --green: #2f7a52; --green-tint: #d3e7da; --amber: #c98a12; --amber-tint: #f5e2b8;
    --red: #c8402c; --red-tint: #f6d3cb; --select: #f5e2b8;
    --display: "Planner", "Arial Narrow", sans-serif;
    --text: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html { background: var(--paper); }
  body { margin: 0; padding: 32px 16px 80px; background: var(--paper); color: var(--ink);
         font: 15px/1.5 var(--text); font-variant-numeric: tabular-nums; -webkit-font-smoothing: antialiased; }
  ::selection { background: var(--select); color: var(--ink); }
  main { max-width: 1180px; margin: 0 auto; }
  a { color: inherit; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  {% for r in ranked %}main:has(#c-{{ r.slug }}:target) a[href="#c-{{ r.slug }}"]{{ ', ' if not loop.last }}{% endfor %} { text-decoration: underline; }
  {% for r in ranked %}main:has(#c-{{ r.slug }}:target) a[href="#c-{{ r.slug }}"]::before{{ ', ' if not loop.last }}{% endfor %} { transform: translateY(-4px) rotate(45deg); }
  .drill-link:focus-visible { outline: 0; }
  .drill-link:focus-visible::after { outline: 2px solid var(--ink); outline-offset: -1px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  code { font: 12.5px/1 ui-monospace, "SF Mono", Menlo, monospace; color: var(--muted); user-select: all; }

  /* Masthead: the planner's top rule */
  .masthead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 24px;
              border-bottom: 3px solid var(--ink); padding-bottom: 10px; }
  .masthead h1 { font: 700 26px/1 var(--display); letter-spacing: .04em; text-transform: uppercase; margin: 0; }
  .masthead p { margin: 0; color: var(--muted); font-size: 13.5px; }

  /* Notes: coverage warnings and the needs-review link, right under the masthead */
  .notes { margin: 28px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .notes li { padding: 9px 0; border-bottom: 1px solid var(--rule); display: flex; gap: 12px; align-items: baseline; }
  .notes li::before { content: ""; flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--amber); transform: translateY(-1px); }
  .notes li.alert::before { background: var(--red); }

  /* Section headings: condensed caps over a ruled line */
  section { margin-top: 64px; }
  .masthead + section, .notes + section { margin-top: 40px; }
  section > h2 { font: 700 15px/1 var(--display); letter-spacing: .12em; text-transform: uppercase;
                 margin: 0 0 6px; padding-bottom: 9px; border-bottom: 1.5px solid var(--ink); }
  .lede { color: var(--muted); margin: 12px 0 18px; max-width: 75ch; }

  /* Spending per month: one bar per planner column, against the month's share of the budget */
  .bars svg { display: block; width: 100%; min-width: 720px; height: auto; }
  .bars .col { fill: var(--column); }
  .bars .month-rule { stroke: var(--ink); stroke-width: 1; }
  .bars .grid { stroke: var(--hair); stroke-width: 1; }
  .bars .axis { stroke: var(--ink); stroke-width: 1.5; }
  .bars text { font: 500 13px var(--display); fill: var(--muted); letter-spacing: .04em; }
  .bars .month { font-weight: 700; fill: var(--ink); letter-spacing: .08em; text-transform: uppercase; }
  .bars .amount { font-size: 15px; fill: var(--ink); letter-spacing: 0; }
  .bars .amount.fill-red { fill: var(--red); }
  .bars .bar { shape-rendering: crispEdges; }
  .bars .share { stroke: var(--ink); stroke-width: 2; shape-rendering: crispEdges; }
  .bars .drill { display: none; }
  .bars .drill:target, .bars .drill.all { display: block; }
  .bars .drill { scroll-margin-top: 56px; }
  .bars .drill:target ~ .drill.all { display: none; }
  .drill-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; margin-top: 18px; }
  .drill-head h3 { font: 700 22px/1 var(--display); letter-spacing: .04em; text-transform: uppercase; margin: 0; }
  .drill-head p { margin: 0; color: var(--muted); }
  .drill-head a { margin-left: auto; font-size: 13.5px; }
  .drill .lede { margin-top: 8px; }
  .drill h4 { font: 700 13px/1 var(--display); letter-spacing: .08em; text-transform: uppercase; margin: 36px 0 0;
              padding-bottom: 8px; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; }
  .drill h4 span { color: var(--muted); font-weight: 500; letter-spacing: .04em; }
  .drill .tx { margin: 0; width: 100%; }
  .fill-green { fill: var(--green); } .fill-amber { fill: var(--amber); } .fill-red { fill: var(--red); }

  /* Where the money went: each category against its own limit; the limit is one ruled line down the list */
  .ranked { margin: 0; }
  .rank-row { display: grid; grid-template-columns: minmax(150px, 1.1fr) minmax(200px, 3fr) 76px 96px 110px 120px;
              gap: 16px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--hair); }
  .rank-row.head { padding: 6px 0; border-bottom-color: var(--rule); color: var(--muted); font-size: 12.5px; }
  .rank-row.total { border-top: 1.5px solid var(--ink); border-bottom: 0; font-weight: 650; }
  .rank-row .name { font-weight: 600; }
  .rank-row:has(.drill-link) { position: relative; }
  .drill-link { text-decoration: none; display: inline-flex; align-items: baseline; gap: 10px; }
  .drill-link::before { content: ""; flex: none; width: 7px; height: 7px; border-right: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink);
                        transform: translateY(-2px) rotate(-45deg); transition: transform .2s cubic-bezier(.16, 1, .3, 1); }
  .drill-link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .drill-link:hover { text-decoration: underline; }
  .drill-link:hover::before { transform: translate(2px, -2px) rotate(-45deg); }
  .rank-row.head .name-head { padding-left: 17px; }
  .rank-row .num { text-align: right; white-space: nowrap; }
  .rank-row .num small { display: block; color: var(--muted); font-size: 12.5px; font-weight: 400; }
  .rank-row .used { font: 500 22px/1 var(--display); }
  .rank-row.total .used { font-weight: 700; }
  .neg, .rank-row .num small.neg { color: var(--red); }
  .track { position: relative; align-self: stretch; min-height: 18px; margin: -11px 0; }
  .track::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 1px dotted var(--rule); }
  .track .fill, .track .over { position: absolute; top: 50%; height: 14px; margin-top: -7px; }
  .track .fill { left: 0; border-radius: 2px; }
  .track .over { border-radius: 0 2px 2px 0;
                 background: repeating-linear-gradient(-45deg, var(--red) 0 3px, var(--red-tint) 3px 6px); }
  .track .over.capped { border-radius: 0; clip-path: polygon(0 0, 100% 0, calc(100% - 9px) 50%, 100% 100%, 0 100%); }
  .track .limit { position: absolute; top: 0; bottom: -1px; width: 2px; margin-left: -1px; background: var(--ink); }
  .head .track { margin: -6px 0; }
  .head .track::before { display: none; }
  .head .track .mark { position: absolute; bottom: 7px; font: 700 12px/1 var(--display); letter-spacing: .08em;
                       text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .head .track .mark.at-limit { margin-left: 8px; color: var(--ink); }
  .head .track .mark.at-end { right: 0; }
  .bg-green { background: var(--green); } .bg-amber { background: var(--amber); } .bg-red { background: var(--red); }
  .scale-note { display: flex; gap: 22px; flex-wrap: wrap; color: var(--muted); font-size: 12.5px; margin-top: 12px; }
  .key { display: inline-flex; align-items: center; gap: 7px; }
  .key i { display: inline-block; width: 18px; height: 10px; border-radius: 2px; }
  .key i.tick { width: 2px; height: 16px; background: var(--ink); border-radius: 0; }
  .key i.hatch { background: repeating-linear-gradient(-45deg, var(--red) 0 3px, var(--red-tint) 3px 6px); }
  .key i.cut { background: repeating-linear-gradient(-45deg, var(--red) 0 3px, var(--red-tint) 3px 6px); border-radius: 0;
               clip-path: polygon(0 0, 100% 0, calc(100% - 5px) 50%, 100% 100%, 0 100%); }

  /* Month-by-month planner */
  .scroll { overflow-x: auto; scrollbar-color: var(--rule) transparent; }
  table { border-collapse: collapse; width: 100%; }
  .planner { table-layout: fixed; min-width: 980px; }
  .planner th, .planner td { border-left: 1px solid var(--ink); padding: 0; }
  .planner th:first-child, .planner td:first-child { border-left: 0; width: 196px; text-align: left; padding-right: 12px; }
  .planner thead th { font: 700 13px/1 var(--display); letter-spacing: .08em; text-transform: uppercase; text-align: center;
                      padding: 8px 0 9px; border-bottom: 1.5px solid var(--ink); }
  .planner tbody td:first-child { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .planner tbody tr { border-bottom: 1px solid var(--hair); }
  .planner tbody tr.total { border-top: 1.5px solid var(--ink); border-bottom: 0; }
  .planner tbody tr:nth-child(odd) td + td { background: var(--column); }
  .cell { position: relative; height: 40px; }
  .cell .ink { position: absolute; left: 3px; right: 3px; bottom: 3px; border-radius: 2px; }
  .cell .ink.green { background: var(--green-tint); } .cell .ink.amber { background: var(--amber-tint); } .cell .ink.red { background: var(--red-tint); }
  .cell .ink.red::after { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--red); border-radius: 2px 2px 0 0; }
  .cell span { position: relative; display: block; text-align: right; padding: 13px 7px 0 0; font-size: 12.5px; }
  .planner-key { display: flex; gap: 22px; flex-wrap: wrap; color: var(--muted); font-size: 12.5px; margin-top: 12px; }
  .planner-key i.green { background: var(--green-tint); } .planner-key i.amber { background: var(--amber-tint); }
  .planner-key i.red { background: var(--red-tint); box-shadow: inset 0 3px 0 var(--red); }

  /* Transaction lists */
  details { border-bottom: 1px solid var(--hair); }
  summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 18px 1fr auto 130px; gap: 12px;
            align-items: baseline; padding: 11px 0; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: ""; width: 7px; height: 7px; border-right: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink);
                    transform: translateY(-2px) rotate(-45deg); transition: transform .2s cubic-bezier(.16, 1, .3, 1); }
  details[open] > summary::before { transform: translateY(-4px) rotate(45deg); }
  summary:hover .cat { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  summary .cat { font-weight: 600; }
  summary .count { color: var(--muted); font-size: 13.5px; }
  summary .amount { text-align: right; }
  .tx { margin: 2px 0 18px 30px; width: calc(100% - 30px); font-size: 14px; }
  .tx th { font-weight: 500; color: var(--muted); font-size: 12.5px; text-align: left; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--rule); }
  .tx td { padding: 6px 12px 6px 0; border-bottom: 1px solid var(--hair); vertical-align: top; }
  .tx tr:last-child td { border-bottom: 0; }
  .tx .num { text-align: right; white-space: nowrap; }
  .tx .date { white-space: nowrap; color: var(--muted); width: 96px; }
  .tx td.desc { overflow-wrap: anywhere; }
  .tx .low { color: var(--red); }
  .empty { color: var(--muted); padding: 14px 0; margin: 0; }

  footer { margin-top: 72px; padding-top: 10px; border-top: 3px solid var(--ink); color: var(--muted); font-size: 12.5px; }

  @media (max-width: 760px) {
    body { padding-top: 20px; }
    section { margin-top: 48px; }
    .rank-row { grid-template-columns: 1fr auto auto; gap: 8px 14px; align-items: baseline; }
    .rank-row .name { grid-column: 1; } .rank-row .month-limit { grid-column: 2; grid-row: 1; color: var(--muted); font-size: 13.5px; }
    .rank-row .used { grid-column: 3; grid-row: 1; }
    .rank-row .month-limit small.sr { position: static; width: auto; height: auto; overflow: visible; clip-path: none; display: inline; font-size: inherit; }
    .rank-row .track { grid-column: 1 / -1; grid-row: 2; margin: 0; height: 22px; }
    .rank-row .spent, .rank-row .limit-col { display: none; }
    .rank-row.head { display: none; }
    .drill-head a { margin-left: 0; flex-basis: 100%; }
    summary { grid-template-columns: 18px 1fr auto; }
    summary .count { grid-column: 2; grid-row: 2; }
    .tx { margin-left: 0; width: 100%; }
    .tx .fp-col { display: none; }
    .planner th:first-child, .planner td:first-child { width: 136px; }
    .planner tbody td:first-child { font-size: 13px; white-space: normal; line-height: 1.2; }
  }
</style>
</head>
<body>
<svg width="0" height="0" style="position: absolute" aria-hidden="true"><defs><pattern id="over-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
  <rect width="6" height="6" fill="var(--red-tint)"/><rect width="3" height="6" fill="var(--red)"/>
</pattern></defs></svg>
<main>

<header class="masthead">
  <h1>Household budget</h1>
  <p>{{ b.window.first_day.strftime('%d.%m.%Y') }} – {{ b.window.end.strftime('%d.%m.%Y') }} · last import {{ last_import or 'never' }}</p>
</header>

{% if b.coverage_warnings or b.needs_review or b.uncategorized_spent %}
<ul class="notes">
  {% for w in b.coverage_warnings %}<li>{{ w }}</li>{% endfor %}
  {% if b.needs_review %}<li class="alert"><span><a href="#review">{{ b.needs_review|length }} transactions need review</a>: uncategorized or a low-confidence category.</span></li>{% endif %}
  {% if b.uncategorized_spent %}<li>{{ b.uncategorized_spent|money }} {{ currency }} of uncategorized spending is not included in the totals.</li>{% endif %}
</ul>
{% endif %}

<section aria-labelledby="where-h">
  <h2 id="where-h">Where the money went</h2>
  <p class="lede">Each category against its own yearly limit. The black line is the limit: a bar that crosses it is over. Most over the limit first. Pick a category to see its months and transactions.</p>
  <div class="ranked" role="table" aria-label="Spending by category against each category's limit">
    <div class="rank-row head" role="row">
      <span class="name-head" role="columnheader">Category</span>
      <div class="track" role="columnheader"><span class="mark">0</span><span class="mark at-limit" style="left: {{ ranked[0].limit_pct if ranked else 50 }}%">Limit</span><span class="mark at-end">{{ rank_scale }}%</span>{% if ranked %}<span class="limit" style="left: {{ ranked[0].limit_pct }}%"></span>{% endif %}</div>
      <span class="num" role="columnheader">Of limit</span>
      <span class="num" role="columnheader">Per month</span>
      <span class="num" role="columnheader">Spent</span><span class="num limit-col" role="columnheader">Limit · left</span>
    </div>
    {% for r in ranked %}
    {% set used = '%.0f'|format(r.used_pct) ~ '%' if r.used_pct is not none else '–' %}
    <div class="rank-row" role="row">
      <span class="name" role="cell"><a class="drill-link" href="#c-{{ r.slug }}">{{ r.name }}</a></span>
      <div class="track" role="cell" aria-label="{{ used }} of limit">
        <span class="fill bg-{{ r.state or 'green' }}" style="width: {{ [r.bar_pct, r.limit_pct]|min|round(2) }}%"></span>
        {% if r.bar_pct > r.limit_pct %}<span class="over{{ ' capped' if r.capped }}" style="left: {{ r.limit_pct|round(2) }}%; width: {{ (r.bar_pct - r.limit_pct)|round(2) }}%"></span>{% endif %}
        {% if r.limit %}<span class="limit" style="left: {{ r.limit_pct|round(2) }}%"></span>{% endif %}
      </div>
      <span class="num used{{ ' neg' if r.state == 'red' }}" role="cell">{{ used }}</span>
      <span class="num month-limit" role="cell">{{ r.month_limit|money }}<small class="sr"> per month</small></span>
      <span class="num spent" role="cell">{{ r.spent|money }}</span>
      <span class="num limit-col" role="cell">{{ r.limit|money }}{% if r.limit is none %}<small>–</small>{% elif r.spent > r.limit %}<small class="neg">{{ (r.spent - r.limit)|money }} over</small>{% else %}<small>{{ (r.limit - r.spent)|money }} left</small>{% endif %}</span>
    </div>
    {% endfor %}
    <div class="rank-row total" role="row">
      <span class="name" role="cell"><a class="drill-link" href="#spending">Total</a></span><span role="cell"></span>
      <span class="num used{{ ' neg' if b.total_remaining < 0 }}" role="cell">{{ '%.0f'|format(b.total_used_pct) ~ '%' if b.total_used_pct is not none else '–' }}</span>
      <span class="num month-limit" role="cell">{{ (b.total_limit / 12)|money }}<small class="sr"> per month</small></span>
      <span class="num spent" role="cell">{{ b.total_spent|money }}</span>
      <span class="num limit-col" role="cell">{{ b.total_limit|money }}{% if b.total_remaining < 0 %}<small class="neg">{{ (-b.total_remaining)|money }} over</small>{% else %}<small>{{ b.total_remaining|money }} left</small>{% endif %}</span>
    </div>
  </div>
  <div class="scale-note">
    <span class="key"><i class="bg-green"></i>Under 75% of limit</span>
    <span class="key"><i class="bg-amber"></i>75–100%</span>
    <span class="key"><i class="bg-red"></i>Over the limit</span>
    <span class="key"><i class="hatch"></i>Spending beyond the limit</span>
    <span class="key"><i class="cut"></i>More than {{ rank_scale }}%, cut off</span>
    <span class="key"><i class="tick"></i>Yearly limit</span>
    <span>Amounts in {{ currency }}.</span>
  </div>
</section>

{% macro tx_table(txs, show_category=false) %}
<table class="tx">
  <thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th>{% if show_category %}<th>Category</th><th class="num">Confidence</th>{% endif %}<th class="fp-col">Fingerprint</th></tr></thead>
  <tbody>
  {% for t in txs|sort(attribute='date', reverse=true) %}
  <tr>
    <td class="date">{{ t.date.strftime('%d.%m.%Y') }}</td>
    <td class="desc">{{ t.description }}</td>
    <td class="num">{{ t.amount|money(2) }}</td>
    {% if show_category %}<td>{{ t.category or 'Uncategorized' }}</td><td class="num low">{{ '%.2f'|format(t.confidence) if t.confidence is not none else '' }}</td>{% endif %}
    <td class="fp-col"><code>{{ t.fingerprint[:fp_len] }}</code></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{% macro month_chart(bars, uid) %}
  <div class="scroll"><svg viewBox="0 0 {{ chart.w }} {{ chart.h }}" role="img" aria-labelledby="{{ uid }}-h {{ uid }}-desc">
    <desc id="{{ uid }}-desc">{% for m in bars.bars %}{{ m.label }}{% if m.days %} (days {{ m.days }}){% endif %}: {{ m.spent|money }} of {{ m.allowance|money }} {{ currency }}. {% endfor %}</desc>
    {% for m in bars.bars %}{% if loop.index is even %}<rect class="col" x="{{ m.x }}" y="{{ chart.top }}" width="{{ m.w }}" height="{{ bars.baseline - chart.top }}"/>{% endif %}{% endfor %}
    {% for y, v in bars.y_ticks %}
      {% if not loop.first %}<line class="grid" x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ y }}" y2="{{ y }}"/>{% endif %}
      <text x="{{ chart.left - 10 }}" y="{{ y + 4 }}" text-anchor="end">{{ v }}</text>
    {% endfor %}
    {% for m in bars.bars %}
    {% set bw = (m.w * 0.56)|round(1) %}{% set bx = (m.x + (m.w - bw) / 2)|round(1) %}{% set cx = m.x + m.w / 2 %}
    <line class="month-rule" x1="{{ m.x }}" x2="{{ m.x }}" y1="{{ chart.top - 26 }}" y2="{{ bars.baseline }}"/>
    <text class="month" x="{{ cx }}" y="{{ chart.top - 11 }}" text-anchor="middle">{{ m.label }}</text>
    {% if m.days %}<text x="{{ cx }}" y="{{ bars.baseline + 20 }}" text-anchor="middle">days {{ m.days }}</text>{% endif %}
    <g>
      {% if m.spent > 0 %}
      <rect class="bar fill-{{ m.state }}" x="{{ bx }}" y="{{ m.over_y }}" width="{{ bw }}" height="{{ (bars.baseline - m.over_y)|round(1) }}"/>
      {% if m.over_y > m.bar_top %}<rect class="bar" fill="url(#over-hatch)" x="{{ bx }}" y="{{ m.bar_top }}" width="{{ bw }}" height="{{ (m.over_y - m.bar_top)|round(1) }}"/>{% endif %}
      {% endif %}
      <title>{{ m.label }}: {{ m.spent|money }} of {{ m.allowance|money }} {{ currency }}</title>
    </g>
    <line class="share" x1="{{ bx - 7 }}" x2="{{ bx + bw + 7 }}" y1="{{ m.share_y }}" y2="{{ m.share_y }}"/>
    {% if m.spent > 0 %}<text class="amount{{ ' fill-red' if m.state == 'red' }}" x="{{ cx }}" y="{{ ([m.bar_top, m.share_y]|min - 8)|round(1) }}" text-anchor="middle">{{ m.spent|money }}</text>{% endif %}
    {% endfor %}
    <line class="month-rule" x1="{{ chart.right }}" x2="{{ chart.right }}" y1="{{ chart.top - 26 }}" y2="{{ bars.baseline }}"/>
    <line class="axis" x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ bars.baseline }}" y2="{{ bars.baseline }}"/>
  </svg></div>
{% endmacro %}

<section class="bars" id="spending" aria-labelledby="bars-h">
  <h2 id="bars-h">Spending per month</h2>
  {% for r in ranked %}
  {% set txs = transactions[r.name] %}
  <div class="drill" id="c-{{ r.slug }}">
    <div class="drill-head">
      <h3 id="c-{{ r.slug }}-h">{{ r.name }}</h3>
      <p>{{ r.month_limit|money }} {{ currency }} per month{% if r.used_pct is not none %} · {{ '%.0f'|format(r.used_pct) }}% of the yearly limit{% endif %}</p>
      <a href="#spending">Back to all categories</a>
    </div>
    <p class="lede">{{ r.name }}, month by month. The black line across each column is that month's share of its {{ r.limit|money }} {{ currency }} yearly limit; spending above it is over.</p>
    {{ month_chart(category_bars[r.name], 'c-' ~ r.slug) }}
    <h4>Transactions <span>{{ txs|length }} · {{ r.spent|money }} {{ currency }}</span></h4>
    {% if txs %}<div class="scroll">{{ tx_table(txs) }}</div>{% else %}<p class="empty">No transactions in the window.</p>{% endif %}
  </div>
  {% endfor %}
  <div class="drill all" id="all">
    <div class="drill-head"><h3 id="all-h">All categories</h3><p>{{ (b.total_limit / 12)|money }} {{ currency }} per month</p></div>
    <p class="lede">Everything spent in budgeted categories, month by month. The black line across each column is that month's share of the yearly budget; spending above it is over.</p>
    {{ month_chart(bars, 'all') }}
  </div>
  <div class="scale-note">
    <span class="key"><i class="bg-green"></i>Under 75% of the month's share</span>
    <span class="key"><i class="bg-amber"></i>75–100%</span>
    <span class="key"><i class="bg-red"></i>Over the month's share</span>
    <span class="key"><i class="hatch"></i>Spending above the share</span>
    <span class="key"><i class="tick"></i>The month's share of the yearly budget</span>
    <span>Partial first and last months get a partial share.</span>
  </div>
</section>

<section aria-labelledby="months-h">
  <h2 id="months-h">Month by month</h2>
  <p class="lede">Each cell fills up against the category's monthly share of its yearly limit. A full cell means that month used its whole share; a red top edge means it went over.</p>
  <div class="scroll">
  <table class="planner">
    <thead><tr><th scope="col"><span class="sr">Category</span></th>{% for m in month_labels %}<th scope="col">{{ m }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for name, cells in grid %}
    <tr class="{{ 'total' if loop.last }}">
      <td>{{ name }}</td>
      {% for c in cells %}
      <td><div class="cell" title="{{ name }}, {{ month_labels[loop.index0] }}: {{ c.spent|money }} of {{ c.allowance|money }} {{ currency }}">
        {% if c.spent > 0 %}<div class="ink {{ c.state }}" style="height: {{ (34 * c.fill_pct / 100)|round(1) }}px"></div>{% endif %}
        <span>{{ c.spent|money if c.spent else '' }}</span>
      </div></td>
      {% endfor %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="planner-key">
    <span class="key"><i class="green"></i>Under 75% of the month's share</span>
    <span class="key"><i class="amber"></i>75–100%</span>
    <span class="key"><i class="red"></i>Over the month's share</span>
  </div>
</section>


<section aria-labelledby="outside-h">
  <h2 id="outside-h">Outside the budget</h2>
  <p class="lede">Net money in (+) or out (−) over the window. These never count toward the budget.</p>
  {% for ln in b.non_budgeted %}
  <details>
    <summary><span class="cat">{{ ln.name }}</span><span class="count">{{ ln.transactions|length }} transactions</span><span class="amount">net {{ (-ln.spent)|money }} {{ currency }}</span></summary>
    <div class="scroll">{{ tx_table(ln.transactions) }}</div>
  </details>
  {% endfor %}
</section>

<section id="review" aria-labelledby="review-h">
  <h2 id="review-h">Needs review</h2>
  {% if b.needs_review %}
  <p class="lede">Uncategorized, or categorized with confidence below 0.6. To fix one, add its fingerprint to <code>overrides.toml</code> under <code>[transactions]</code>, e.g. <code>"&lt;fingerprint&gt;" = "{{ b.lines[0].name if b.lines else 'Category' }}"</code>, then run again.</p>
  <div class="scroll">{{ tx_table(b.needs_review, show_category=true) }}</div>
  {% else %}
  <p class="empty">Nothing to review. Every transaction has a confident category.</p>
  {% endif %}
</section>

<footer>Generated {{ generated }}</footer>
</main>
</body>
</html>
